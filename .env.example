APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=realitycheckai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1900

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# For local development, keep the log mailer. For Gmail SMTP, see README.md.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Set the Cloud Object Storage endpoint when required by the bucket configuration.
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenAI Chat Completions API
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# Custom gateway (OpenAI-compatible). Leave default to use OpenAI directly.
OPENAI_BASE_URL=https://api.openai.com/v1

OPENAI_TIMEOUT=30
OPENAI_RETRIES=2
OPENAI_RATE_LIMIT_MAX_RETRIES=2
OPENAI_RATE_LIMIT_BASE_DELAY=2
OPENAI_RATE_LIMIT_MAX_DELAY=30
OPENAI_RATE_LIMIT_INLINE_MAX_WAIT=10
OPENAI_RETRY_JITTER=0.2
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_DOCUMENT_CHARS=12000

# Per-task models: smaller/faster for grading, stronger for quiz/recommendations.
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MODEL_ASSESSMENT=gpt-4o-mini
OPENAI_MODEL_QUIZ=gpt-4o-mini
OPENAI_MODEL_ANSWER=gpt-4o-mini

# Max completion tokens per task (bounds cost and latency).
OPENAI_ASSESSMENT_MAX_TOKENS=1200
OPENAI_QUIZ_MAX_TOKENS=6000

OPENAI_QUIZ_JSON_RETRIES=3
OPENAI_QUIZ_JOB_TIMEOUT=1800
OPENAI_ANSWER_JSON_RETRIES=2

# Seconds to reuse a validated AI quiz for identical material (0 disables caching).
# Repeat uploads of the same document skip the API call entirely.
OPENAI_QUIZ_CACHE_TTL=604800
